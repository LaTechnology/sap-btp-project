<core:FragmentDefinition xmlns="sap.m"
                        xmlns:core="sap.ui.core"
                        xmlns:html="http://www.w3.org/1999/xhtml">
   <Dialog
        title="Select the type of customer"
        id="customerDialog"
        class="sapUiResponsiveContentPadding"
    >
        <VBox>
            <Table
                id="dealerTable" selectionChange="onSelectionChange"
                inset="false"
                mode="MultiSelect"
                items="{path : 'UTCLCustomer>/Dealer', parameters:{expand : 'toAddress,toRetailer'}}"
            >
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="Dealer" />
                    </OverflowToolbar>
                </headerToolbar>

                <columns>

                 <Column>
                        <Text text="Dealer ID" />
                    </Column>

                    <Column>
                        <Text text="First Name" />
                    </Column>
                    <Column>
                        <Text text="Last Name" />
                    </Column>
                    <Column>
                        <Text text="Email" />
                    </Column>
                    <Column>
                        <Text text="Mobile Number" />
                    </Column>
                     <Column>
                        <Text text="Address" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                        <Text text="{UTCLCustomer>dealerID}" />
                            <Text text="{UTCLCustomer>firstName}" />
                            <Text text="{UTCLCustomer>lastName}" /> 
                            <Text text="{UTCLCustomer>email}" />
                            <Text text="{UTCLCustomer>mobileNumber}" />
                           <Text text="{UTCLCustomer>toAddress/0/addressLine1}" />
                            
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>

            <Table
                id="retailerTable" selectionChange="onSelectionChange"
                inset="false"
                mode="MultiSelect"
                items="{path : 'UTCLCustomer>/Retailer', parameters :{expand : 'toAddress'}}"
           
            >
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="Retailer" />
                    </OverflowToolbar>
                </headerToolbar>

                <columns>

                       <Column>
                        <Text text="Retailer Id" />
                    </Column>

                    <Column>
                        <Text text="First Name" />
                    </Column>
                    <Column>
                        <Text text="Last Name" />
                    </Column>
                    <Column>
                        <Text text="Email" />
                    </Column>
                    <Column>
                        <Text text="Mobile Number" />
                    </Column>
                      <Column>
                        <Text text="Address" />
                    </Column>
             
             
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                           <Text text="{UTCLCustomer>retailerId}" />
                            <Text text="{UTCLCustomer>firstName}" />
                            <Text text="{UTCLCustomer>lastName}" /> 
                            <Text text="{UTCLCustomer>email}" />
                            <Text text="{UTCLCustomer>mobileNumber}" />
                            <Text text="{UTCLCustomer>/toAddress>addressLine1}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>

        <beginButton>
            <Button
                text="Select and Continue"
                press="onSave"
                type="Emphasized"
            />
        </beginButton>
        <endButton>
            <Button
                text="Close"
                press="onClose"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
