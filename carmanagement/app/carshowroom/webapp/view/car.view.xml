<mvc:View controllerName="ns.carshowroom.controller.car"
    xmlns:mvc="sap.ui.core.mvc" displayBlock="true"
    xmlns="sap.m">
       <Shell id="_IDGenShell1">
    <Page id="page" title="{i18n>title}">
 <content>
            <Table id="_IDGenTable1" items="{/Car}" >
              <headerToolbar >
         <Toolbar>
            <Title text="{i18n>carListTitle}" />
            <ToolbarSpacer/>
            <SearchField 
               width="50%" 
               search=".onFilterCar"/>
         </Toolbar>
      </headerToolbar>
                <columns>
                    <Column id="_IDGenColumn1" >
                        <Label id="_IDGenLabel1" text="Id" ></Label>
                    </Column>
                     <Column id="_IDGenColumn2">
                        <Label id="_IDGenLabel2" text="carName"></Label>
                    </Column>
                    <Column id="_IDGenColumn3">
                    <Label id="_IDGenLabel3" text="manufactureDate"></Label>
                    </Column>
                   </columns>
                   <items>
                
                <ColumnListItem type="Navigation"
                press=".onListItemPress " id="_IDGenColumnListItem1" >
                        <cells>
                            <Text id="_IDGenText1" text="{Id}" ></Text>
                            <Text id="_IDGenText2" text="{carName}"></Text>
                            <Text id="_IDGenText3" text="{manufactureDate}"></Text>
                        </cells>                    
                    </ColumnListItem>
                </items>
            </Table>
        </content>    </Page>
        </Shell>

</mvc:View>
