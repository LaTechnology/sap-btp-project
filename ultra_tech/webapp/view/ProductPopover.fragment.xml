<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<ResponsivePopover
		id="myPopover"
		title="Product Details"
		class="sapUiContentPadding"
		placement="Vertical">
		<content>
			<HBox justifyContent="SpaceBetween" alignItems="Center">
				<Image src="image/Untitled.png" width="15em" />
				<Table inset="false" items="{productModel>/products}">
					<headerToolbar>
						<Toolbar>
							<Title text="Product Details" />
						</Toolbar>
					</headerToolbar>
					<columns>
						<Column>
							<Label text="" />
						</Column>
						<Column>
							<Label text="Product Code" />
						</Column>
						<Column>
							<Label text="Description" />
						</Column>
						<Column>
							<Label text="Quantity" />
						</Column>
						<Column>
							<Label text="Price" />
						</Column>
						
					</columns>
					<items>
						<ColumnListItem>
							<cells>
								<CheckBox selected="{selected}" />
								<Text text="productCode" />
								<Text text="description" />
								<Text text="quantity" />
								<Text text="price" />
							</cells>
						</ColumnListItem>
					</items>
				</Table>
			</HBox>
		</content>
		<beginButton>
			<Button text="OK" press="handleCloseButton" />
		</beginButton>
		<endButton>
			<Button text="Cancel" press="handleCloseButton" />
		</endButton>
	</ResponsivePopover>
</core:FragmentDefinition>
