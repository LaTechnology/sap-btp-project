<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:layout="sap.ui.layout">
    <WizardStep id="CustomerSelection" nextStep="CustomerDetails" title="Customer Selection" icon="sap-icon://e-care">
        <layout:VerticalLayout>
            <Text text="Select Customer type" />
            <ComboBox textAlign="Begin">
                <core:ListItem key="Dealer" text="DEALER ONLY" />
                <core:ListItem key="Retailer" text="RETAILERS ONLY" />
                <core:ListItem key="DealerandRetailer" text="DEALER AND RETAILER" />
            </ComboBox>
        </layout:VerticalLayout>
    </WizardStep>
  
</core:FragmentDefinition>
