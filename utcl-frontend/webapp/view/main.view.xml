<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    controllerName="utclfrontend.controller.main"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    displayBlock="true"
>
    <Page id="page">
        <headerContent>
            <Bar>
                <contentLeft>
                    <Image src="https://www.ultratechcement.com/content/experience-fragments/ultratechcement/in/en/site/header/master/_jcr_content/root/container_965997150/container_1473792216/image.coreimg.png/1707298113035/ultratech-cement-logo.png" width="8%" ></Image>
                </contentLeft>
                <contentLeft>
                    <Text text="UTCL Checkout" />
                </contentLeft>
            </Bar>
        </headerContent>

        <f:DynamicPage id="dynamicpage">
            <f:title>
                <f:DynamicPageTitle>
                    <f:heading>
                        <Title text="Customer Selection" />
                    </f:heading>
                </f:DynamicPageTitle>
            </f:title>

            <f:content>
                <Wizard id="utclWizards" class="sapUiResponsivePadding--header sapUiResponsivePadding--content" complete="completedHandler" height="auto" showNextButton="true">
                    <core:Fragment fragmentName="utclfrontend.view.CustomerSelection" type="XML" />
                    <core:Fragment fragmentName="utclfrontend.view.CustomerDetails" type="XML" />
                </Wizard>
            </f:content>
        </f:DynamicPage>
    </Page>
</mvc:View>
