<mvc:View 
    controllerName="ns.calculator.controller.main"
    xmlns:mvc="sap.ui.core.mvc" 
    displayBlock="true"
    xmlns="sap.m">
    
    <Page id="page" title="Calculator">
        <Bar></Bar>
        <FlexBox alignContent="Center">
            <Input id="input" value="" placeholder="Enter calculation here"></Input>
        </FlexBox>

        <FlexBox height="100px" alignItems="Stretch">
            <Button text="1" type="Emphasized" class="sapUiSmallMarginEnd" press="buttoncalculator"/>  
            <Button text="2" type="Reject" class="sapUiSmallMarginEnd" press="buttoncalculator"/>  
            <Button text="3" type="Accept" class="sapUiSmallMarginEnd" press="buttoncalculator"/> 
            <Button text="4" class="sapUiSmallMarginEnd" press="buttoncalculator"/> 
        </FlexBox>

        <FlexBox height="100px" alignItems="Stretch">
            <Button text="5" type="Emphasized" class="sapUiSmallMarginEnd" press="buttoncalculator"/>
            <Button text="6" type="Reject" class="sapUiSmallMarginEnd" press="buttoncalculator"/>
            <Button text="7" type="Accept" class="sapUiSmallMarginEnd" press="buttoncalculator"/>
            <Button text="8" class="sapUiSmallMarginEnd" press="buttoncalculator"/>
        </FlexBox>

        <FlexBox height="100px" alignItems="Stretch">
            <Button text="9" type="Emphasized" class="sapUiSmallMarginEnd" press="buttoncalculator"/>
            <Button text="0" type="Reject" class="sapUiSmallMarginEnd" press="buttoncalculator"/>
            <Button text="*" type="Accept" class="sapUiSmallMarginEnd" press="buttoncalculator"/>
            <Button text="/" class="sapUiSmallMarginEnd" press="buttoncalculator"/>
        </FlexBox>

        <FlexBox height="100px" alignItems="Stretch">
            <Button text="C" type="Emphasized" class="sapUiSmallMarginEnd" press="buttoncalculator"/>
            <Button text="+" type="Reject" class="sapUiSmallMarginEnd" press="buttoncalculator"/>
            <Button text="-" type="Accept" class="sapUiSmallMarginEnd" press="buttoncalculator"/>
            <Button text="=" class="sapUiSmallMarginEnd" press="buttoncalculator"/>
        </FlexBox>
    </Page>
</mvc:View>
